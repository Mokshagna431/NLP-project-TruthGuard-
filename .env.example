# =============================================================================
# TRUTHGUARD ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database Configuration (PostgreSQL / Supabase / Local SQLite)
# For Supabase / Production PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
# For Local Development (Default zero-config SQLite):
DATABASE_URL=sqlite:///./truthguard.db

# Authentication & Security
JWT_SECRET_KEY=truthguard-production-jwt-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Machine Learning & Inference Settings
DEFAULT_DECOMPOSITION=atomic_llm
DEFAULT_RETRIEVAL=hybrid
DEFAULT_VERIFIER=nli
TAU_E=0.70
TAU_C=0.70
TAU_R=0.10
LAMBDA_NEI=0.50

# Hardware Acceleration
CUDA_VISIBLE_DEVICES=
PYTORCH_ENABLE_MPS_FALLBACK=1
OMP_NUM_THREADS=8
